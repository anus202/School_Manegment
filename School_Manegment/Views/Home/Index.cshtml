@{
    ViewData["Title"] = "Dashboard";
}

<style>

    .dashboard-wrapper {
        width: 100%;
        padding: 0;
    }

    .stat-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #f3f4f6;
        padding: 20px;
        height: 100%;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

        .stat-card:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

    .icon-box {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 20px;
    }

    .bg-blue-light {
        background-color: #eff6ff;
        color: #2563eb;
    }

    .bg-green-light {
        background-color: #f0fdf4;
        color: #16a34a;
    }

    .bg-purple-light {
        background-color: #faf5ff;
        color: #9333ea;
    }

    .bg-amber-light {
        background-color: #fffbeb;
        color: #d97706;
    }

    .bg-teal-light {
        background-color: #f0fdfa;
        color: #0d9488;
    }

    .bg-red-light {
        background-color: #fef2f2;
        color: #dc2626;
    }

    .trend-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .trend-up {
        background-color: #f0fdf4;
        color: #16a34a;
    }

    .trend-down {
        background-color: #fef2f2;
        color: #dc2626;
    }

    .progress-bar-custom {
        height: 6px;
        background-color: #f3f4f6;
        border-radius: 9999px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 9999px;
    }

    .chart-container {
        position: relative;
        height: 280px;
        width: 100%;
    }

</style>


<div class="dashboard-wrapper">

    <!-- HEADER -->

    <div class="mb-4">

        <h1 class="h4 fw-bold text-dark mb-1">
            Welcome to Dashboard
        </h1>

    </div>


    <!-- STAT CARDS -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl">

            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="icon-box bg-blue-light">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <span class="trend-badge trend-up">
                        <i class="bi bi-graph-up-arrow"></i>
                        4.2%
                    </span>

                </div>

                <h2 class="h3 fw-bold text-dark m-0">
                    1,248
                </h2>

                <p class="text-secondary small m-0 mt-1">
                    Total Students
                </p>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl">

            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="icon-box bg-green-light">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <span class="trend-badge trend-up">
                        <i class="bi bi-graph-up-arrow"></i>
                        1.1%
                    </span>

                </div>

                <h2 class="h3 fw-bold text-dark m-0">
                    86
                </h2>

                <p class="text-secondary small m-0 mt-1">
                    Total Teachers
                </p>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl">

            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="icon-box bg-purple-light">
                        <i class="bi bi-book-fill"></i>
                    </div>

                    <span class="trend-badge trend-up">
                        <i class="bi bi-graph-up-arrow"></i>
                        0%
                    </span>

                </div>

                <h2 class="h3 fw-bold text-dark m-0">
                    34
                </h2>

                <p class="text-secondary small m-0 mt-1">
                    Total Classes
                </p>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl">

            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="icon-box bg-amber-light">
                        <i class="bi bi-currency-dollar"></i>
                    </div>

                    <span class="trend-badge trend-down">
                        <i class="bi bi-graph-down-arrow"></i>
                        2.8%
                    </span>

                </div>

                <h2 class="h3 fw-bold text-dark m-0">
                    Rs. 2.4M
                </h2>

                <p class="text-secondary small m-0 mt-1">
                    Total Revenue
                </p>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl">

            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div class="icon-box bg-teal-light">
                        <i class="bi bi-activity"></i>
                    </div>

                    <span class="trend-badge trend-up">
                        <i class="bi bi-graph-up-arrow"></i>
                        0.6%
                    </span>

                </div>

                <h2 class="h3 fw-bold text-dark m-0">
                    91.5%
                </h2>

                <p class="text-secondary small m-0 mt-1">
                    Attendance Rate
                </p>

            </div>

        </div>

    </div>


    <!-- ATTENDANCE -->


    <!-- CHARTS -->

    <div class="row g-3">

        <div class="col-12 col-lg-8">

            <div class="stat-card">

                <h5 class="fw-bold text-dark mb-4">
                    Weekly Attendance
                </h5>

                <div class="chart-container">

                    <canvas id="weeklyAttendanceChart"></canvas>

                </div>

            </div>

        </div>


        <div class="col-12 col-lg-4">

            <div class="stat-card">

                <h5 class="fw-bold text-dark mb-4">
                    Fee Collection
                </h5>

                <div class="chart-container">

                    <canvas id="feeCollectionChart"></canvas>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        // Current Date

        const options = {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        };


        // Weekly Attendance Chart

        const ctxBar =
            document
                .getElementById("weeklyAttendanceChart")
                .getContext("2d");

        new Chart(ctxBar, {

            type: "bar",

            data: {

                labels: [
                    "Mon",
                    "Tue",
                    "Wed",
                    "Thu",
                    "Fri"
                ],

                datasets: [

                    {
                        label: "Present",

                        data: [
                            420,
                            405,
                            430,
                            410,
                            395
                        ],

                        backgroundColor: "#3B82F6",

                        borderRadius: 6
                    },

                    {
                        label: "Absent",

                        data: [
                            30,
                            45,
                            20,
                            40,
                            55
                        ],

                        backgroundColor: "#FCA5A5",

                        borderRadius: 6
                    }

                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        position: "top"
                    }
                },

                scales: {

                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        grid: {
                            borderDash: [
                                3,
                                3
                            ]
                        }
                    }

                }

            }

        });


        // Fee Collection Chart

        const ctxPie =
            document
                .getElementById("feeCollectionChart")
                .getContext("2d");

        new Chart(ctxPie, {

            type: "doughnut",

            data: {

                labels: [
                    "Paid",
                    "Pending",
                    "Overdue"
                ],

                datasets: [{

                    data: [
                        68,
                        22,
                        10
                    ],

                    backgroundColor: [
                        "#F59E0B",
                        "#FCD34D",
                        "#FDE68A"
                    ],

                    borderWidth: 2,

                    borderColor: "#ffffff"

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        position: "bottom"
                    }

                },

                cutout: "65%"

            }

        });

    </script>
}
