@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - School Management
    </title>


    <!-- =========================
         BOOTSTRAP
    ========================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =========================
         BOOTSTRAP ICONS
    ========================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- =========================
         GOOGLE FONT
    ========================== -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =========================
         TOAST CSS
    ========================== -->

    <link rel="stylesheet"
          href="~/css/toast.css" />


    <!-- =========================
         JQUERY
    ========================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/Ajax/toast.js"></script>


    <style>

            * {
                box-sizing: border-box;
            }


            html,
            body {
                width: 100%;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
                font-family: 'Inter', sans-serif;
                background: #f8fafc;
                color: #334155;
            }


            /* =====================================================
                       TOP NAVBAR
                    ===================================================== */

            .top-navbar {
                height: 65px;
                background: linear-gradient( 135deg, #ffffff 0%, #e0f2fe 100% );
                border-bottom: 1px solid #bae6fd;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 22px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1100;
                box-shadow: 0 2px 12px rgba(14, 165, 233, 0.08);
            }


            /* =====================================================
                       NAVBAR LEFT
                    ===================================================== */

            .navbar-left {
                display: flex;
                align-items: center;
                gap: 15px;
                min-width: 250px;
            }


            /* =====================================================
                       MOBILE MENU
                    ===================================================== */

            .mobile-menu {
                display: none;
                border: none;
                background: transparent;
                color: #0284c7;
                font-size: 25px;
                cursor: pointer;
                padding: 5px;
            }


            /* =====================================================
                       BRAND
                    ===================================================== */

            .brand {
                font-size: 20px;
                font-weight: 800;
                color: #0284c7;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                white-space: nowrap;
            }


                .brand i {
                    font-size: 25px;
                    color: #0369a1;
                }


            /* =====================================================
                       NAVBAR SEARCH
                    ===================================================== */

            .navbar-search {
                position: relative;
                width: 360px;
                margin-left: auto;
                margin-right: 25px;
            }


                .navbar-search i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #64748b;
                    font-size: 16px;
                    z-index: 2;
                }


                .navbar-search input {
                    width: 100%;
                    height: 40px;
                    border: 1px solid #bae6fd;
                    border-radius: 10px;
                    padding: 0 15px 0 42px;
                    outline: none;
                    background: #ffffff;
                    color: #334155;
                    font-size: 13px;
                    transition: all 0.2s;
                }


                    .navbar-search input:focus {
                        border-color: #38bdf8;
                        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
                    }


            /* =====================================================
                       NAVBAR RIGHT
                    ===================================================== */

            .navbar-right {
                display: flex;
                align-items: center;
                gap: 10px;
            }


            /* =====================================================
                       NAV ICON BUTTON
                    ===================================================== */

            .nav-icon-btn {
                width: 39px;
                height: 39px;
                border: 1px solid #bae6fd;
                background: #ffffff;
                color: #0369a1;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                position: relative;
                transition: all 0.2s;
            }


                .nav-icon-btn:hover {
                    background: #f0f9ff;
                    border-color: #7dd3fc;
                    transform: translateY(-1px);
                }


            .notification-badge {
                position: absolute;
                top: -4px;
                right: -4px;
                min-width: 17px;
                height: 17px;
                padding: 0 4px;
                background: #ef4444;
                color: white;
                border-radius: 20px;
                font-size: 9px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid white;
            }


            /* =====================================================
                       PROFILE
                    ===================================================== */

            .profile-area {
                display: flex;
                align-items: center;
                gap: 9px;
                padding-left: 8px;
                margin-left: 5px;
                border-left: 1px solid #bae6fd;
            }


            .profile-img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: linear-gradient( 135deg, #38bdf8, #0284c7 );
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                box-shadow: 0 3px 8px rgba(2, 132, 199, 0.25);
            }


            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.2;
            }


            .profile-name {
                font-weight: 700;
                color: #0f172a;
                font-size: 13px;
                max-width: 180px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }


            .profile-role {
                font-size: 10px;
                color: #64748b;
                margin-top: 3px;
            }


            /* =====================================================
                       SIDEBAR
                    ===================================================== */

            .sidebar {
                position: fixed;
                top: 65px;
                left: 0;
                width: 250px;
                height: calc(100vh - 65px);
                background: #ffffff;
                border-right: 1px solid #e0f2fe;
                padding: 16px 13px;
                overflow-y: auto;
                z-index: 1000;
                box-shadow: 4px 0 15px rgba(14, 165, 233, 0.03);
                transition: width 0.25s ease, transform 0.25s ease;
            }


            /* =====================================================
                       SIDEBAR HEADER
                    ===================================================== */

            .sidebar-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 5px 12px;
            }


            .sidebar-label {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                color: #94a3b8;
            }


            .sidebar-collapse {
                border: none;
                background: #f0f9ff;
                color: #0284c7;
                width: 30px;
                height: 30px;
                border-radius: 8px;
                cursor: pointer;
            }


            /* =====================================================
                       SIDEBAR SEARCH
                    ===================================================== */

            .sidebar-search {
                position: relative;
                margin-bottom: 15px;
            }


                .sidebar-search i {
                    position: absolute;
                    left: 12px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #94a3b8;
                    font-size: 14px;
                }


                .sidebar-search input {
                    width: 100%;
                    height: 37px;
                    border: 1px solid #e2e8f0;
                    border-radius: 9px;
                    padding: 0 10px 0 35px;
                    outline: none;
                    background: #f8fafc;
                    font-size: 12px;
                    color: #334155;
                }


                    .sidebar-search input:focus {
                        background: white;
                        border-color: #7dd3fc;
                    }


            /* =====================================================
                       SECTION TITLE
                    ===================================================== */

            .sidebar-title {
                color: #0284c7;
                font-size: 10px;
                font-weight: 800;
                text-transform: uppercase;
                padding: 12px 11px 6px;
                letter-spacing: 0.8px;
            }


            /* =====================================================
                       NORMAL LINK
                    ===================================================== */

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 13px;
                margin-bottom: 4px;
                color: #475569;
                text-decoration: none;
                border-radius: 9px;
                font-weight: 500;
                font-size: 13px;
                transition: all 0.2s ease;
            }


                .sidebar-link i {
                    font-size: 17px;
                    width: 21px;
                    color: #0284c7;
                    transition: transform 0.2s;
                }


                .sidebar-link:hover {
                    background: #f0f9ff;
                    color: #0369a1;
                    padding-left: 17px;
                }


                    .sidebar-link:hover i {
                        transform: scale(1.08);
                    }


                /* =====================================================
                       ACTIVE LINK
                    ===================================================== */

                .sidebar-link.active {
                    background: linear-gradient( 135deg, #38bdf8 0%, #0284c7 100% );
                    color: #ffffff;
                    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.22);
                }


                    .sidebar-link.active i {
                        color: #ffffff;
                    }


            /* =====================================================
                       PARENT MENU
                    ===================================================== */

            .sidebar-parent {
                width: 100%;
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 13px;
                margin-bottom: 3px;
                color: #475569;
                border-radius: 9px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s ease;
            }


            .parent-content {
                display: flex;
                align-items: center;
                gap: 12px;
            }


                .parent-content i {
                    font-size: 17px;
                    width: 21px;
                    color: #0284c7;
                }


            .sidebar-parent:hover {
                background: #f0f9ff;
                color: #0369a1;
            }


            .menu-arrow {
                font-size: 11px;
                transition: transform 0.25s ease;
            }


            .sidebar-parent.open .menu-arrow {
                transform: rotate(180deg);
            }


            .sidebar-parent.open {
                background: #f0f9ff;
                color: #0369a1;
            }


            /* =====================================================
                       SUB MENU
                    ===================================================== */

            .sidebar-submenu {
                max-height: 0;
                overflow: hidden;
                opacity: 0;
                padding-left: 19px;
                transition: max-height 0.3s ease, opacity 0.25s ease;
            }


                .sidebar-submenu.show {
                    max-height: 350px;
                    opacity: 1;
                }


            .submenu-link {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 12px 8px 20px;
                margin-bottom: 3px;
                color: #64748b;
                text-decoration: none;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 500;
                position: relative;
                transition: all 0.2s ease;
            }


                .submenu-link i {
                    font-size: 14px;
                    width: 17px;
                    color: #38bdf8;
                }


                .submenu-link::before {
                    content: "";
                    position: absolute;
                    left: 8px;
                    top: 0;
                    bottom: 0;
                    width: 1px;
                    background: #e0f2fe;
                }


                .submenu-link:hover {
                    background: #f0f9ff;
                    color: #0369a1;
                    padding-left: 24px;
                }


                .submenu-link.active {
                    background: linear-gradient( 135deg, #38bdf8, #0284c7 );
                    color: white;
                    box-shadow: 0 3px 8px rgba(2, 132, 199, 0.18);
                }


                    .submenu-link.active i {
                        color: white;
                    }


                    .submenu-link.active::before {
                        display: none;
                    }


            /* =====================================================
                       MAIN CONTENT
                    ===================================================== */

            .main-content {
                margin-left: 250px;
                padding: 88px 30px 30px;
                min-height: 100vh;
                width: calc(100% - 250px);
                transition: margin-left 0.25s ease, width 0.25s ease;
            }


            /* =====================================================
                       QUICK ADD DROPDOWN
                    ===================================================== */

            .quick-add {
                position: relative;
            }


            .quick-menu {
                position: absolute;
                top: 48px;
                right: 0;
                width: 190px;
                background: white;
                border: 1px solid #e0f2fe;
                border-radius: 10px;
                padding: 7px;
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
                display: none;
                z-index: 2000;
            }


                .quick-menu.show {
                    display: block;
                }


                .quick-menu a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 9px 10px;
                    border-radius: 7px;
                    text-decoration: none;
                    color: #475569;
                    font-size: 12px;
                    font-weight: 500;
                }


                    .quick-menu a:hover {
                        background: #f0f9ff;
                        color: #0369a1;
                    }


                .quick-menu i {
                    color: #0284c7;
                    font-size: 15px;
                }


            /* =====================================================
                       NOTIFICATION PANEL
                    ===================================================== */

            .notification-wrapper {
                position: relative;
            }


            .notification-panel {
                position: absolute;
                top: 48px;
                right: 0;
                width: 300px;
                background: white;
                border: 1px solid #e0f2fe;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
                display: none;
                overflow: hidden;
                z-index: 2000;
            }


                .notification-panel.show {
                    display: block;
                }


            .notification-header {
                padding: 13px 15px;
                border-bottom: 1px solid #f1f5f9;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }


                .notification-header strong {
                    font-size: 13px;
                    color: #0f172a;
                }


                .notification-header span {
                    font-size: 10px;
                    color: #0284c7;
                }


            .notification-item {
                display: flex;
                gap: 10px;
                padding: 12px 15px;
                border-bottom: 1px solid #f8fafc;
            }


            .notification-icon {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: #f0f9ff;
                color: #0284c7;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            .notification-item p {
                margin: 0;
                font-size: 11px;
                color: #475569;
            }


            .notification-item small {
                color: #94a3b8;
                font-size: 9px;
            }


            /* =====================================================
                       SIDEBAR OVERLAY
                    ===================================================== */

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 65px 0 0 0;
                background: rgba(15, 23, 42, 0.35);
                z-index: 900;
            }


            /* =====================================================
                       RESPONSIVE
                    ===================================================== */

            @@media (max-width: 1100px) {

                .navbar-search {
                    width: 260px;
                }

                .profile-info {
                    display: none;
                }
            }


            @@media (max-width: 768px) {

                .top-navbar {
                    padding: 0 13px;
                }


                .mobile-menu {
                    display: block;
                }


                .navbar-left {
                    min-width: auto;
                }


                .brand span {
                    display: none;
                }


                .navbar-search {
                    display: none;
                }


                .sidebar {
                    transform: translateX(-100%);
                    width: 250px;
                }


                    .sidebar.show {
                        transform: translateX(0);
                    }


                .sidebar-overlay.show {
                    display: block;
                }


                .main-content {
                    margin-left: 0;
                    width: 100%;
                    padding: 82px 15px 25px;
                }


                .profile-info {
                    display: none;
                }


                .notification-panel {
                    right: -60px;
                    width: 280px;
                }
            }


            @@media (max-width: 480px) {

                .profile-area {
                    border-left: none;
                    padding-left: 0;
                }


                .quick-add {
                    display: none;
                }


                .nav-icon-btn {
                    width: 35px;
                    height: 35px;
                }


                .profile-img {
                    width: 36px;
                    height: 36px;
                }
            }

    </style>

</head>


<body>


    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <nav class="top-navbar">


        <!-- LEFT -->

        <div class="navbar-left">


            <!-- MOBILE -->

            <button type="button"
                    class="mobile-menu"
                    onclick="toggleSidebar()">

                <i class="bi bi-list"></i>

            </button>


            <!-- BRAND -->

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <i class="bi bi-mortarboard-fill"></i>

                <span>
                    School Management
                </span>

            </a>

        </div>


        <!-- =================================================
             NAVBAR SEARCH
        ================================================== -->

        <div class="navbar-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="globalSearch"
                   placeholder="Search students, teachers..."
                   autocomplete="off" />

        </div>


        <!-- =================================================
             RIGHT SIDE
        ================================================== -->

        <div class="navbar-right">


            <!-- QUICK ADD -->

            <div class="quick-add">

                <button type="button"
                        class="nav-icon-btn"
                        onclick="toggleQuickMenu()"
                        title="Quick Add">

                    <i class="bi bi-plus-lg"></i>

                </button>


                <div class="quick-menu"
                     id="quickMenu">


                    <a asp-controller="Student"
                       asp-action="StudentForm">

                        <i class="bi bi-person-plus"></i>

                        <span>
                            Add Student
                        </span>

                    </a>


                    <a asp-controller="Teacher"
                       asp-action="Create">

                        <i class="bi bi-person-workspace"></i>

                        <span>
                            Add Teacher
                        </span>

                    </a>


                    <a asp-controller="SCH_Class"
                       asp-action="Create">

                        <i class="bi bi-building-add"></i>

                        <span>
                            Add Class
                        </span>

                    </a>


                    <a asp-controller="Subject"
                       asp-action="Create">

                        <i class="bi bi-book"></i>

                        <span>
                            Add Subject
                        </span>

                    </a>

                </div>

            </div>


            <!-- NOTIFICATION -->

            <div class="notification-wrapper">

                <button type="button"
                        class="nav-icon-btn"
                        onclick="toggleNotifications()"
                        title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-badge">
                        3
                    </span>

                </button>


                <div class="notification-panel"
                     id="notificationPanel">


                    <div class="notification-header">

                        <strong>
                            Notifications
                        </strong>

                        <span>
                            3 New
                        </span>

                    </div>


                    <div class="notification-item">

                        <div class="notification-icon">

                            <i class="bi bi-people"></i>

                        </div>

                        <div>

                            <p>
                                New student registration
                            </p>

                            <small>
                                Recently
                            </small>

                        </div>

                    </div>


                    <div class="notification-item">

                        <div class="notification-icon">

                            <i class="bi bi-person-workspace"></i>

                        </div>

                        <div>

                            <p>
                                Teacher profile updated
                            </p>

                            <small>
                                Today
                            </small>

                        </div>

                    </div>


                    <div class="notification-item">

                        <div class="notification-icon">

                            <i class="bi bi-check-circle"></i>

                        </div>

                        <div>

                            <p>
                                System is running normally
                            </p>

                            <small>
                                Today
                            </small>

                        </div>

                    </div>

                </div>

            </div>


            <!-- PROFILE -->

            <div class="profile-area">


                <div class="profile-img"
                     id="profileInitial">

                    A

                </div>


                <div class="profile-info">

                    <span class="profile-name"
                          id="profileEmail">

                        Admin

                    </span>


                    <span class="profile-role">

                        Administrator

                    </span>

                </div>

            </div>

        </div>

    </nav>


    <!-- =====================================================
         SIDEBAR OVERLAY
    ====================================================== -->

    <div class="sidebar-overlay"
         id="sidebarOverlay"
         onclick="toggleSidebar()">
    </div>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar"
           id="sidebar">


        <!-- SIDEBAR HEADER -->

        <div class="sidebar-header">

            <span class="sidebar-label">
                Navigation
            </span>


           

        </div>


        <!-- SIDEBAR SEARCH -->

        <div class="sidebar-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="sidebarSearch"
                   placeholder="Search menu..."
                   autocomplete="off" />

        </div>


        <!-- =================================================
             MAIN MENU
        ================================================== -->

        <div class="sidebar-title">
            Main Menu
        </div>


        <!-- DASHBOARD -->

        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">

            <i class="bi bi-speedometer2"></i>

            <span>
                Dashboard
            </span>

        </a>


        <!-- =================================================
             MANAGEMENT
        ================================================== -->

        <div class="sidebar-title">
            Management
        </div>


        <!-- =================================================
             STUDENTS
        ================================================== -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-parent @(currentController == "Student" ? "open" : "")"
                    onclick="toggleMenu('studentMenu', this)">


                <span class="parent-content">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Students
                    </span>

                </span>


                <i class="bi bi-chevron-down menu-arrow"></i>

            </button>


            <div id="studentMenu"
                 class="sidebar-submenu @(currentController == "Student" ? "show" : "")">


                <a asp-controller="Student"
                   asp-action="Index"
                   class="submenu-link @(currentController == "Student" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-list-ul"></i>

                    <span>
                        Student List
                    </span>

                </a>


                <a asp-controller="Student"
                   asp-action="Create"
                   class="submenu-link @(currentController == "Student" && currentAction == "Create" ? "active" : "")">

                    <i class="bi bi-person-plus"></i>

                    <span>
                        Add Student
                    </span>

                </a>

            </div>

        </div>


        <!-- =================================================
             TEACHERS
        ================================================== -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-parent @(currentController == "Teacher" ? "open" : "")"
                    onclick="toggleMenu('teacherMenu', this)">


                <span class="parent-content">

                    <i class="bi bi-person-workspace"></i>

                    <span>
                        Teachers
                    </span>

                </span>


                <i class="bi bi-chevron-down menu-arrow"></i>

            </button>


            <div id="teacherMenu"
                 class="sidebar-submenu @(currentController == "Teacher" ? "show" : "")">


                <a asp-controller="Teacher"
                   asp-action="Index"
                   class="submenu-link @(currentController == "Teacher" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-list-ul"></i>

                    <span>
                        Teacher List
                    </span>

                </a>


                <a asp-controller="Teacher"
                   asp-action="Create"
                   class="submenu-link @(currentController == "Teacher" && currentAction == "Create" ? "active" : "")">

                    <i class="bi bi-person-plus"></i>

                    <span>
                        Add Teacher
                    </span>

                </a>

            </div>

        </div>


        <!-- =================================================
             CLASSES
        ================================================== -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-parent @(currentController == "SCH_Class" ? "open" : "")"
                    onclick="toggleMenu('classMenu', this)">


                <span class="parent-content">

                    <i class="bi bi-building"></i>

                    <span>
                        Classes
                    </span>

                </span>


                <i class="bi bi-chevron-down menu-arrow"></i>

            </button>


            <div id="classMenu"
                 class="sidebar-submenu @(currentController == "SCH_Class" ? "show" : "")">


                <a asp-controller="SCH_Class"
                   asp-action="Index"
                   class="submenu-link @(currentController == "SCH_Class" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-list-ul"></i>

                    <span>
                        Class List
                    </span>

                </a>


                <a asp-controller="SCH_Class"
                   asp-action="Create"
                   class="submenu-link @(currentController == "SCH_Class" && currentAction == "Create" ? "active" : "")">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Add Class
                    </span>

                </a>

            </div>

        </div>


        <!-- =================================================
             SUBJECTS
        ================================================== -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-parent @(currentController == "Subject" ? "open" : "")"
                    onclick="toggleMenu('subjectMenu', this)">


                <span class="parent-content">

                    <i class="bi bi-book"></i>

                    <span>
                        Subjects
                    </span>

                </span>


                <i class="bi bi-chevron-down menu-arrow"></i>

            </button>


            <div id="subjectMenu"
                 class="sidebar-submenu @(currentController == "Subject" ? "show" : "")">


                <a asp-controller="Subject"
                   asp-action="Index"
                   class="submenu-link @(currentController == "Subject" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-list-ul"></i>

                    <span>
                        Subject List
                    </span>

                </a>


                <a asp-controller="Subject"
                   asp-action="Create"
                   class="submenu-link @(currentController == "Subject" && currentAction == "Create" ? "active" : "")">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Add Subject
                    </span>

                </a>

            </div>

        </div>


        <!-- =================================================
             SETTINGS
        ================================================== -->

        <div class="sidebar-title">
            Settings
        </div>


        <a asp-controller="Setup"
           asp-action="Index"
           class="sidebar-link @(currentController == "Setup" ? "active" : "")">

            <i class="bi bi-gear-fill"></i>

            <span>
                Settings
            </span>

        </a>


        <a asp-controller="Home"
           asp-action="Privacy"
           class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")">

            <i class="bi bi-shield-lock-fill"></i>

            <span>
                Privacy
            </span>

        </a>


        <!-- =================================================
             ACCOUNT
        ================================================== -->

        <div class="sidebar-title">
            Account
        </div>


        <a href="javascript:void(0)"
           onclick="logoutUser()"
           class="sidebar-link logout-link">

            <i class="bi bi-box-arrow-right"></i>

            <span>
                Logout
            </span>

        </a>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main-content">

        @RenderBody()

    </main>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>


            /* =====================================================
               SIDEBAR
            ===================================================== */

            function toggleSidebar() {

                const sidebar =
                    document.getElementById("sidebar");

                const overlay =
                    document.getElementById("sidebarOverlay");


                sidebar.classList.toggle("show");

                overlay.classList.toggle("show");
            }



            /* =====================================================
               SUB MENU
            ===================================================== */

            function toggleMenu(menuId, button) {

                const menu =
                    document.getElementById(menuId);


                if (!menu) {
                    return;
                }


                menu.classList.toggle("show");

                button.classList.toggle("open");
            }



            /* =====================================================
               QUICK ADD
            ===================================================== */

            function toggleQuickMenu() {

                const menu =
                    document.getElementById("quickMenu");

                const notification =
                    document.getElementById("notificationPanel");


                notification.classList.remove("show");

                menu.classList.toggle("show");
            }



            /* =====================================================
               NOTIFICATIONS
            ===================================================== */

            function toggleNotifications() {

                const panel =
                    document.getElementById("notificationPanel");

                const quickMenu =
                    document.getElementById("quickMenu");


                quickMenu.classList.remove("show");

                panel.classList.toggle("show");
            }



            /* =====================================================
               CLOSE DROPDOWNS WHEN CLICK OUTSIDE
            ===================================================== */

            document.addEventListener(
                "click",
                function (event) {

                    const quick =
                        document.querySelector(".quick-add");

                    const notification =
                        document.querySelector(".notification-wrapper");


                    if (
                        quick &&
                        !quick.contains(event.target)
                    ) {

                        document
                            .getElementById("quickMenu")
                            .classList
                            .remove("show");
                    }


                    if (
                        notification &&
                        !notification.contains(event.target)
                    ) {

                        document
                            .getElementById("notificationPanel")
                            .classList
                            .remove("show");
                    }

                }
            );



            /* =====================================================
               SIDEBAR SEARCH
            ===================================================== */

            document
                .getElementById("sidebarSearch")
                .addEventListener(
                    "input",
                    function () {

                        const search =
                            this.value
                                .toLowerCase()
                                .trim();


                        const links =
                            document.querySelectorAll(
                                ".sidebar-link, .submenu-link"
                            );


                        links.forEach(function (link) {

                            const text =
                                link.innerText
                                    .toLowerCase();


                            if (
                                search === "" ||
                                text.includes(search)
                            ) {

                                link.style.display = "flex";

                            }
                            else {

                                link.style.display = "none";

                            }

                        });


                        // Parent groups automatically open
                        if (search !== "") {

                            document
                                .querySelectorAll(
                                    ".sidebar-submenu"
                                )
                                .forEach(function (menu) {

                                    menu.classList.add("show");

                                });


                            document
                                .querySelectorAll(
                                    ".sidebar-parent"
                                )
                                .forEach(function (button) {

                                    button.classList.add("open");

                                });

                        }

                    }
                );



            /* =====================================================
               GLOBAL SEARCH
            ===================================================== */

            document
                .getElementById("globalSearch")
                .addEventListener(
                    "keyup",
                    function (event) {

                        const value =
                            this.value
                                .trim()
                                .toLowerCase();


                        if (
                            event.key === "Enter" &&
                            value !== ""
                        ) {

                            /*
                             * Future:
                             * Global search API yahan call
                             * kar sakte hain.
                             */

                            console.log(
                                "Global Search:",
                                value
                            );


                            if (typeof showToast === "function") {

                                showToast(
                                    "Searching for: " + value,
                                    "info"
                                );

                            }

                        }

                    }
                );



            /* =====================================================
               JWT EMAIL
            ===================================================== */

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const token =
                        localStorage.getItem("token");


                    if (!token) {

                        return;

                    }


                    try {

                        const parts =
                            token.split(".");


                        if (parts.length !== 3) {

                            return;

                        }


                        const payload =
                            parts[1];


                        const decodedPayload =
                            atob(
                                payload
                                    .replace(/-/g, "+")
                                    .replace(/_/g, "/")
                            );


                        const user =
                            JSON.parse(decodedPayload);


                        console.log(
                            "JWT User:",
                            user
                        );


                        const email =
                            user.email ||
                            user.Email ||
                            user[
                            "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
                            ];


                        if (email) {

                            const emailElement =
                                document.getElementById(
                                    "profileEmail"
                                );


                            const initialElement =
                                document.getElementById(
                                    "profileInitial"
                                );


                            if (emailElement) {

                                emailElement.textContent =
                                    email;

                            }


                            if (initialElement) {

                                initialElement.textContent =
                                    email
                                        .charAt(0)
                                        .toUpperCase();

                            }

                        }

                    }
                    catch (error) {

                        console.error(
                            "JWT decode error:",
                            error
                        );

                    }

                }
            );



            /* =====================================================
               LOGIN SUCCESS TOAST
            ===================================================== */

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const message =
                        sessionStorage.getItem(
                            "toastMessage"
                        );


                    if (
                        message &&
                        typeof showToast === "function"
                    ) {

                        showToast(
                            message,
                            "success"
                        );


                        sessionStorage.removeItem(
                            "toastMessage"
                        );

                    }

                }
            );



            /* =====================================================
               LOGOUT
            ===================================================== */

            function logoutUser() {

                const token =
                    localStorage.getItem("token");


                // Token remove
                localStorage.removeItem("token");


                // Temporary toast remove
                sessionStorage.removeItem(
                    "toastMessage"
                );


                // Login page
                window.location.href =
                    "/Login/LoginForm";
            }


    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>